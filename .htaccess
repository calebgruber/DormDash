RewriteEngine On

# Block direct access to includes directory (PHP includes, not user-facing pages)
<FilesMatch "\.php$">
  <If "%{REQUEST_URI} =~ m|^/includes/|">
    Require all denied
  </If>
</FilesMatch>

# Block direct access to config PHP files, EXCEPT the admin settings page (config/index.php)
<FilesMatch "\.php$">
  <If "%{REQUEST_URI} =~ m|^/config/| && %{REQUEST_URI} !~ m|^/config/index\.php$|">
    Require all denied
  </If>
</FilesMatch>

# Deny access to hidden files
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

Options -Indexes
